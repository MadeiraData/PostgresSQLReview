WITH
inputs AS (
  SELECT
    (:'total_ram_gb')::numeric AS ram_gb,
    (CASE lower(:'storage_type') WHEN 'ssd' THEN 1 ELSE 0 END) AS is_ssd,
    lower(:'workload') AS workload,
    lower(:'role') AS role
),
mem AS (
  SELECT
    ram_gb,
    /* shared_buffers: ~25% of RAM, clamp 1GB..16GB */
    LEAST(GREATEST(ram_gb * 0.25, 1), 16) AS shared_buffers_gb,
    /* effective_cache_size: ~70% of RAM */
    GREATEST(ram_gb * 0.70, 1) AS effective_cache_size_gb,
    /* maintenance_work_mem: 1–2 GB typical, scale with RAM but clamp */
    LEAST(GREATEST(ram_gb * 0.05, 0.5), 4) AS maint_work_mem_gb,
    /* work_mem per op: conservative 0.5% of RAM, clamp 16–128MB */
    LEAST(GREATEST(ram_gb * 0.005 * 1024, 16), 128)::int AS work_mem_mb
  FROM inputs
),
io AS (
  SELECT
    CASE WHEN is_ssd=1 THEN 1.2 ELSE 4.0 END AS random_page_cost,
    1.0 AS seq_page_cost,
    CASE WHEN is_ssd=1 THEN 200 ELSE 0 END AS effective_io_concurrency
  FROM inputs
),
wal AS (
  SELECT
    /* OLTP likes synchronous_commit=on; OLAP bulk loads may go off temporarily */
    CASE WHEN workload='oltp' THEN 'on'
         ELSE 'on'
    END AS synchronous_commit,
    /* wal_level based on role/needs */
    CASE WHEN role='primary' THEN 'replica' ELSE 'replica' END AS wal_level,
    20 AS checkpoint_timeout_min,
    16 AS max_wal_size_gb,
    4  AS min_wal_size_gb,
    'on' AS wal_compression
  FROM inputs
),
para AS (
  SELECT
    /* simple parallelism defaults; adjust per CPU later */
    8 AS max_worker_processes,
    8 AS max_parallel_workers,
    2 AS max_parallel_workers_per_gather,
    2 AS max_parallel_maintenance_workers
),
autovac AS (
  SELECT
    'on' AS autovacuum,
    0.1::numeric AS autovacuum_vacuum_scale_factor,
    0.1::numeric AS autovacuum_analyze_scale_factor,
    15 AS autovacuum_naptime_s,
    2000 AS autovacuum_vacuum_cost_limit,
    2 AS autovacuum_vacuum_cost_delay_ms,
    150 AS default_statistics_target
),
logcfg AS (
  SELECT
    'on' AS logging_collector,
    '%m [%p] %u@%d %h ' AS log_line_prefix,
    1000 AS log_min_duration_statement_ms,
    'on' AS log_checkpoints,
    1000 AS log_autovacuum_min_duration_ms,
    'on' AS track_io_timing
),
sec AS (
  SELECT
    'on' AS ssl,
    'scram-sha-256' AS password_encryption,
    'pg_stat_statements' AS shared_preload_libraries,
    30000 AS statement_timeout_ms,
    300000 AS idle_in_transaction_session_timeout_ms,
    'try' AS huge_pages
)
SELECT 
	name,
	current_value || unit,
	recommended_value,
	why
FROM
(
SELECT
  s.name,
  s.setting AS current_value,
  COALESCE(s.unit,'') AS unit,
  r.recommended_value,
  r.why
FROM pg_settings s
JOIN LATERAL (
  SELECT
    CASE s.name
      /* Memory */
      WHEN 'shared_buffers' THEN (SELECT (shared_buffers_gb::text || 'GB') FROM mem)
      WHEN 'effective_cache_size' THEN (SELECT (effective_cache_size_gb::text || 'GB') FROM mem)
      WHEN 'maintenance_work_mem' THEN (SELECT (maint_work_mem_gb::text || 'GB') FROM mem)
      WHEN 'work_mem' THEN (SELECT (work_mem_mb::text || 'MB') FROM mem)
      /* Parallelism */
      WHEN 'max_worker_processes' THEN (SELECT max_worker_processes::text FROM para)
      WHEN 'max_parallel_workers' THEN (SELECT max_parallel_workers::text FROM para)
      WHEN 'max_parallel_workers_per_gather' THEN (SELECT max_parallel_workers_per_gather::text FROM para)
      WHEN 'max_parallel_maintenance_workers' THEN (SELECT max_parallel_maintenance_workers::text FROM para)
      /* I/O costs & concurrency */
      WHEN 'random_page_cost' THEN (SELECT random_page_cost::text FROM io)
      WHEN 'seq_page_cost' THEN (SELECT seq_page_cost::text FROM io)
      WHEN 'effective_io_concurrency' THEN (SELECT effective_io_concurrency::text FROM io)
      /* WAL / checkpoints */
      WHEN 'wal_level' THEN (SELECT wal_level FROM wal)
      WHEN 'synchronous_commit' THEN (SELECT synchronous_commit FROM wal)
      WHEN 'checkpoint_timeout' THEN (SELECT (checkpoint_timeout_min::text || 'min') FROM wal)
      WHEN 'max_wal_size' THEN (SELECT (max_wal_size_gb::text || 'GB') FROM wal)
      WHEN 'min_wal_size' THEN (SELECT (min_wal_size_gb::text || 'GB') FROM wal)
      WHEN 'wal_compression' THEN (SELECT wal_compression FROM wal)
      /* Autovacuum & stats */
      WHEN 'autovacuum' THEN (SELECT autovacuum FROM autovac)
      WHEN 'autovacuum_vacuum_scale_factor' THEN (SELECT autovacuum_vacuum_scale_factor::text FROM autovac)
      WHEN 'autovacuum_analyze_scale_factor' THEN (SELECT autovacuum_analyze_scale_factor::text FROM autovac)
      WHEN 'autovacuum_naptime' THEN (SELECT (autovacuum_naptime_s::text || 's') FROM autovac)
      WHEN 'autovacuum_vacuum_cost_limit' THEN (SELECT autovacuum_vacuum_cost_limit::text FROM autovac)
      WHEN 'autovacuum_vacuum_cost_delay' THEN (SELECT (autovacuum_vacuum_cost_delay_ms::text || 'ms') FROM autovac)
      WHEN 'default_statistics_target' THEN (SELECT default_statistics_target::text FROM autovac)
      /* Logging */
      WHEN 'logging_collector' THEN (SELECT logging_collector FROM logcfg)
      WHEN 'log_line_prefix' THEN (SELECT log_line_prefix FROM logcfg)
      WHEN 'log_min_duration_statement' THEN (SELECT (log_min_duration_statement_ms::text || 'ms') FROM logcfg)
      WHEN 'log_checkpoints' THEN (SELECT log_checkpoints FROM logcfg)
      WHEN 'log_autovacuum_min_duration' THEN (SELECT (log_autovacuum_min_duration_ms::text || 'ms') FROM logcfg)
      WHEN 'track_io_timing' THEN (SELECT track_io_timing FROM logcfg)
      /* Security / misc */
      WHEN 'ssl' THEN (SELECT ssl FROM sec)
      WHEN 'password_encryption' THEN (SELECT password_encryption FROM sec)
      WHEN 'shared_preload_libraries' THEN (SELECT shared_preload_libraries FROM sec)
      WHEN 'statement_timeout' THEN (SELECT (statement_timeout_ms::text || 'ms') FROM sec)
      WHEN 'idle_in_transaction_session_timeout' THEN (SELECT (idle_in_transaction_session_timeout_ms::text || 'ms') FROM sec)
      WHEN 'huge_pages' THEN (SELECT huge_pages FROM sec)
      ELSE NULL
    END AS recommended_value,
    CASE s.name
      WHEN 'shared_buffers' THEN '≈25% RAM; balance with OS cache.'
      WHEN 'effective_cache_size' THEN 'Planner hint; ~70% RAM is typical.'
      WHEN 'maintenance_work_mem' THEN 'Speeds VACUUM/CREATE INDEX; 1–2GB often ideal.'
      WHEN 'work_mem' THEN 'Per sort/hash per node; keep conservative to avoid OOM.'
      WHEN 'max_worker_processes' THEN 'Enables background & parallel workers.'
      WHEN 'max_parallel_workers' THEN 'Upper bound for total parallel workers.'
      WHEN 'max_parallel_workers_per_gather' THEN 'Parallelism per plan node.'
      WHEN 'max_parallel_maintenance_workers' THEN 'Parallel index build/maintenance.'
      WHEN 'random_page_cost' THEN 'Lower on SSD to reflect cheaper random IO.'
      WHEN 'seq_page_cost' THEN 'Baseline sequential IO cost.'
      WHEN 'effective_io_concurrency' THEN 'Higher on SSD to allow more concurrent reads.'
      WHEN 'wal_level' THEN 'replica for streaming; logical only if required.'
      WHEN 'synchronous_commit' THEN 'on for durability; adjust for HA/throughput.'
      WHEN 'checkpoint_timeout' THEN '15–30m balances overhead & recovery time.'
      WHEN 'max_wal_size' THEN 'Larger reduces checkpoint frequency.'
      WHEN 'min_wal_size' THEN 'Keeps WAL segments preallocated.'
      WHEN 'wal_compression' THEN 'Cuts WAL volume at small CPU cost.'
      WHEN 'autovacuum' THEN 'Must be on to prevent bloat.'
      WHEN 'autovacuum_vacuum_scale_factor' THEN 'Lower triggers earlier vacuum on big tables.'
      WHEN 'autovacuum_analyze_scale_factor' THEN 'Keeps stats fresh for planner.'
      WHEN 'autovacuum_naptime' THEN 'Background cadence for vacuum workers.'
      WHEN 'autovacuum_vacuum_cost_limit' THEN 'Let vacuum make faster progress.'
      WHEN 'autovacuum_vacuum_cost_delay' THEN 'Small delay to reduce jitter.'
      WHEN 'default_statistics_target' THEN 'Better histograms/MCV; improves plans.'
      WHEN 'logging_collector' THEN 'Capture logs to files for analysis.'
      WHEN 'log_line_prefix' THEN 'Include timestamp, pid, user@db, host.'
      WHEN 'log_min_duration_statement' THEN 'Find slow queries; tune threshold as needed.'
      WHEN 'log_checkpoints' THEN 'Visibility into checkpoint overhead.'
      WHEN 'log_autovacuum_min_duration' THEN 'Observe long autovacuum runs.'
      WHEN 'track_io_timing' THEN 'Enable per-query IO timing.'
      WHEN 'ssl' THEN 'Encrypt client connections.'
      WHEN 'password_encryption' THEN 'Use modern hashing algorithm.'
      WHEN 'shared_preload_libraries' THEN 'Load pg_stat_statements for profiling.'
      WHEN 'statement_timeout' THEN 'Safety net against runaway queries.'
      WHEN 'idle_in_transaction_session_timeout' THEN 'Prevents long-held locks.'
      WHEN 'huge_pages' THEN 'Improve memory TLB efficiency on large RAM.'
      ELSE NULL
    END AS why
) r ON TRUE
WHERE s.name IN (
  /* Memory / parallelism */
  'shared_buffers','effective_cache_size','work_mem','maintenance_work_mem',
  'max_worker_processes','max_parallel_workers','max_parallel_workers_per_gather','max_parallel_maintenance_workers',
  /* IO & costs */
  'random_page_cost','seq_page_cost','effective_io_concurrency',
  /* WAL / checkpoints */
  'wal_level','synchronous_commit','checkpoint_timeout','max_wal_size','min_wal_size','wal_compression',
  /* Autovacuum / stats */
  'autovacuum','autovacuum_vacuum_scale_factor','autovacuum_analyze_scale_factor',
  'autovacuum_naptime','autovacuum_vacuum_cost_limit','autovacuum_vacuum_cost_delay','default_statistics_target',
  /* Logging / observability */
  'logging_collector','log_line_prefix','log_min_duration_statement','log_checkpoints','log_autovacuum_min_duration','track_io_timing',
  /* Security / misc */
  'ssl','password_encryption','shared_preload_libraries','statement_timeout','idle_in_transaction_session_timeout','huge_pages'
)
ORDER BY s.name
)A
WHERE current_value || unit <> recommended_value;
