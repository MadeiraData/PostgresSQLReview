SELECT
    i.schemaname,
    t.relname AS table_name,
    t.last_analyze,
    t.last_autoanalyze
FROM pg_stat_all_indexes AS i 
JOIN pg_stat_all_tables AS t ON i.relid = t.relid
WHERE i.schemaname NOT IN ('pg_catalog','information_schema','pg_toast')
  AND (COALESCE(t.last_analyze, t.last_autoanalyze) < (current_date - interval '3 days')
       OR (t.last_analyze IS NULL AND t.last_autoanalyze IS NULL))
ORDER BY COALESCE(t.last_analyze, t.last_autoanalyze) NULLS LAST;
